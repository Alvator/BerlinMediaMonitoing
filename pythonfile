# 1. DATENQUELLEN (Meinungsmedien & Diskurs)
# -------------------------------------------------------------
NEWS_FEEDS = {
    "RBB24 Berlin": "https://www.rbb24.de/politik/index.xml/feed=rss.xml",
    "Tagesspiegel Berlin": "https://www.tagesspiegel.de/berlin/rss",
    "Berliner Zeitung": "https://www.berliner-zeitung.de/feed.xml"
}

TOPIC_KEYWORDS = {
    "Wohnen & Mieten": ["wohnen", "miete", "enteignung", "bau", "wohnung", "vorkaufsrecht", "obdachlos"],
    "Verkehr & Mobilität": ["u-bahn", "s-bahn", "bvg", "radweg", "auto", "a100", "parkplatz", "verkehr"],
    "Innere Sicherheit & Polizei": ["polizei", "kriminalität", "sicherheit", "clans", "görlitzer park", "justiz"],
    "Verwaltung & Bürgerdienste": ["bürgeramt", "termin", "digitalisierung", "haushalt", "senat", "bezirke"],
    "Klima & Energie": ["klima", "wärmewende", "gruen", "erneuerbar", "hitze", "energie"]
}

PARTIES = ["SPD", "CDU", "Grüne", "Linke", "AfD", "FDP", "BSW"]

# -------------------------------------------------------------
# 2. INGESTION ENGINE
# -------------------------------------------------------------
def fetch_media_articles(limit_per_source: int = 15):
    """Liest RSS-Feeds relevanter Berliner Medien aus."""
    articles = []
    for source_name, url in NEWS_FEEDS.items():
        try:
            feed = feedparser.parse(url)
            for entry in feed.entries[:limit_per_source]:
                title = entry.get("title", "")
                summary = entry.get("summary", "")
                clean_summary = re.sub("<[^<]+?>", "", summary)
                published = entry.get("published", "")
                link = entry.get("link", "#")

                articles.append({
                    "Quelle": source_name,
                    "Medium": "Leitmedium",
                    "Titel": title,
                    "Text": clean_summary,
                    "Link": link,
                    "Datum": published
                })
        except Exception as e:
            st.sidebar.warning(f"Fehler bei {source_name}: {e}")
    return articles

def fetch_reddit_berlin(query: str = "Wahl", limit: int = 25):
    """Liest aktuelle Diskussions-Threads aus r/berlin aus."""
    articles = []
    url = f"https://www.reddit.com/r/berlin/search.json?q={urllib.parse.quote(query)}&sort=new&limit={limit}"
    headers = {"User-Agent": "PoliticalMediaMonitor/1.0"}
    try:
        resp = requests.get(url, headers=headers, timeout=8)
        if resp.status_code == 200:
            posts = resp.json().get("data", {}).get("children", [])
            for post in posts:
                pdata = post.get("data", {})
                articles.append({
                    "Quelle": "r/berlin (Reddit)",
                    "Medium": "Social Discourse",
                    "Titel": pdata.get("title", ""),
                    "Text": pdata.get("selftext", "")[:400],
                    "Link": f"https://reddit.com{pdata.get('permalink')}",
                    "Datum": datetime.fromtimestamp(pdata.get("created_utc", 0)).strftime("%Y-%m-%d")
                })
    except Exception:
        pass
    return articles

# -------------------------------------------------------------
# 3. NLP- & DISKURS-ANALYSE
# -------------------------------------------------------------
def analyze_text(row):
    combined = f"{row['Titel']} {row['Text']}".lower()

    # Thematisches Tagging
    assigned_topics = []
    for topic, words in TOPIC_KEYWORDS.items():
        if any(w in combined for w in words):
            assigned_topics.append(topic)
    row["Thema"] = assigned_topics[0] if assigned_topics else "Allgemeine Landespolitik"

    # Partei-Erwähnungen
    detected_parties = [p for p in PARTIES if re.search(r'\b' + re.escape(p.lower()) + r'\b', combined)]
    row["Parteien"] = ", ".join(detected_parties) if detected_parties else "Neutral / Keine"

    # Sentiment Heuristik (Computational Lexicon)
    pos_words = ["erfolg", "lösung", "fortschritt", "einigung", "investition", "modern", "chancen", "zuwachs"]
    neg_words = ["krise", "streit", "chaos", "verzug", "panne", "kritik", "mangel", "versagen", "teuer", "verfehlt"]

    pos_score = sum(combined.count(w) for w in pos_words)
    neg_score = sum(combined.count(w) for w in neg_words)

    if pos_score > neg_score:
        sentiment = "Positiv"
        val = 1
    elif neg_score > pos_score:
        sentiment = "Negativ / Kritisch"
        val = -1
    else:
        sentiment = "Neutral / Berichterstattung"
        val = 0

    row["Tonalität"] = sentiment
    row["Sentiment_Val"] = val
    return row

# -------------------------------------------------------------
# 4. LLM BRIEFING GENERATOR (Gemini API)
# -------------------------------------------------------------
def generate_political_briefing(df: pd.DataFrame, api_key: str):
    """Erstellt ein präzises Risiko- und Narrativ-Memo für Public Affairs Agenturen."""
    client = genai.Client(api_key=api_key)
    
    # Stichprobe relevanter Beiträge aufbereiten
    sample_headlines = "\n".join([f"- [{r['Quelle']} | {r['Thema']}] {r['Titel']} ({r['Tonalität']})" for _, r in df.head(20).iterrows()])
    
    prompt = f"""
    Du bist Senior Political & Media Analyst in einer führenden Public-Affairs-Beratung in Berlin.
    Analysiere die folgenden aktuellen Medienberichte und Social-Media-Debatten zum Berliner Wahlkampf:

    {sample_headlines}

    Erstelle ein strukturiertes Executive Briefing für Mandanten mit folgenden Abschnitten:
    1. **Dominante Narrative & Framing**: Welche Themen beherrschen aktuell die Agenda?
    2. **Akteurs- & Parteien-Dynamik**: Wer steht unter Druck, wer kann Themen setzen?
    3. **Risikoanalyse für Kampagnen**: Wo drohen Shitstorms oder Reputationsverluste?
    4. **Strategische Handlungsempfehlung**: Wie sollten Kommunikatoren in dieser Woche reagieren?

    Halte die Sprache prägnant, analytisch und politikwissenschaftlich fundiert.
    """
    response = client.models.generate_content(
        model='gemini-2.5-flash',
        contents=prompt,
    )
    return response.text

